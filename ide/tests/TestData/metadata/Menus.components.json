      "componentEditor": "menu",
      "properties": [],
      "events": []
    },
    {
      "class": "TMainMenu",
      "ancestor": "TMenu",
      "palette": { "page": "Standard", "order": 10 },
      "namePrefix": "MainMenu",
      "properties": [],
      "events": []
    },
    {
