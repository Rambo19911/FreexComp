<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FreexComp.Ide.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FreexComp.Ide\FreexComp.Ide.csproj" />
    <ProjectReference Include="..\..\src\FreexComp.Ide.Core\FreexComp.Ide.Core.csproj" />
    <ProjectReference Include="..\..\src\FreexComp.Designer\FreexComp.Designer.csproj" />
    <ProjectReference Include="..\FreexComp.Ide.TestSupport\FreexComp.Ide.TestSupport.csproj" />
    <!-- I-194: the process tests' helper program; the reference copies its apphost exe next to the tests. -->
    <ProjectReference Include="..\FreexComp.Ide.TestHelper\FreexComp.Ide.TestHelper.csproj" />
    <!-- Phase 6: the debugger area's scripted debug adapter; the reference copies FakeAdapter.exe next to the tests. -->
    <ProjectReference Include="..\..\..\debugger\tests\FakeAdapter\FakeAdapter.csproj" />
    <!-- F09-001: the command-line build driver; the reference copies pbuild.exe next to the tests. -->
    <ProjectReference Include="..\..\..\compiler\src\pbuild\pbuild.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Spec-table reader shared with Core.Tests; it uses xunit, so it is linked rather than put in TestSupport. -->
    <Compile Include="..\FreexComp.Ide.Core.Tests\Infrastructure\SpecTables.cs" Link="Infrastructure\SpecTables.cs" />
    <!-- The buffer contract runs against both implementations (IDE-ARCH-030). -->
    <Compile Include="..\FreexComp.Ide.Core.Tests\Text\TextBufferContractTests.cs" Link="Text\TextBufferContractTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- D-078: the designer views load the test component metadata (testing.md §4). -->
    <None Include="..\TestData\metadata\**\*" LinkBase="TestData\metadata" CopyToOutputDirectory="PreserveNewest" />
    <!-- I-146: scenario files of the scripted debug adapter (testing.md §5.4). -->
    <None Include="..\TestData\debug-scenarios\**\*" LinkBase="TestData\debug-scenarios" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
