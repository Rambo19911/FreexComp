<Project Sdk="Microsoft.NET.Sdk">
  <!-- IDE-ARCH-001: no Avalonia, AvaloniaEdit or Dock reference in this project. -->
  <PropertyGroup>
    <RootNamespace>FreexComp.Ide.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FreexComp.Ide.Core.Tests" />
    <InternalsVisibleTo Include="FreexComp.Ide.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\compiler\src\FreexComp.Compiler\FreexComp.Compiler.csproj" />
    <ProjectReference Include="..\..\..\compiler\src\FreexComp.LanguageService\FreexComp.LanguageService.csproj" />
    <ProjectReference Include="..\..\..\compiler\src\FreexComp.Build\FreexComp.Build.csproj" />
    <ProjectReference Include="..\FreexComp.Designer\FreexComp.Designer.csproj" />
    <!-- Phase 6: the debug session contract (the debug-session interface). -->
    <ProjectReference Include="..\..\..\debugger\src\FreexComp.Debugger\FreexComp.Debugger.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <!-- IDE-ARCH-005 / UI-MSG-001: every user-visible string; accessor generated by the SDK's GenerateResource. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>FreexComp.Ide.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
      <LogicalName>FreexComp.Ide.Core.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- IDE-PM-020: new-project templates, resource names Templates/<id>/<file> (separators normalized at run time). -->
    <EmbeddedResource Include="Templates\**\*" LogicalName="Templates/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- UI-DLG-161: the Third-Party Licenses content, checked against THIRD-PARTY-NOTICES.md by LicensesTests. -->
    <EmbeddedResource Include="Resources\ThirdPartyNotices.json" LogicalName="ThirdPartyNotices.json" />
    <!-- IDE-SET-080: the built-in code templates, in the templates.json schema. -->
    <EmbeddedResource Include="Resources\BuiltInTemplates.json" LogicalName="BuiltInTemplates.json" />
  </ItemGroup>
</Project>
