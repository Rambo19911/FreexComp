{
  "formatVersion": 1,
  "templates": [
    { "abbreviation": "begin", "language": "pascal", "body": "begin\n\t$end$\nend;" },
    { "abbreviation": "if", "language": "pascal", "body": "if $condition$ then\n\t$end$" },
    { "abbreviation": "ife", "language": "pascal", "body": "if $condition$ then\n\t$end$\nelse\n\t" },
    { "abbreviation": "ifb", "language": "pascal", "body": "if $condition$ then\nbegin\n\t$end$\nend;" },
    { "abbreviation": "for", "language": "pascal", "body": "for $i:I$ := $from:0$ to $to$ do\n\t$end$" },
    { "abbreviation": "forb", "language": "pascal", "body": "for $i:I$ := $from:0$ to $to$ do\nbegin\n\t$end$\nend;" },
    { "abbreviation": "forin", "language": "pascal", "body": "for $item$ in $collection$ do\n\t$end$" },
    { "abbreviation": "while", "language": "pascal", "body": "while $condition$ do\nbegin\n\t$end$\nend;" },
    { "abbreviation": "repeat", "language": "pascal", "body": "repeat\n\t$end$\nuntil $condition$;" },
    { "abbreviation": "case", "language": "pascal", "body": "case $expression$ of\n\t$value$: $end$;\nelse\nend;" },
    { "abbreviation": "try", "language": "pascal", "body": "try\n\t$end$\nfinally\n\t$cleanup$;\nend;" },
    { "abbreviation": "trye", "language": "pascal", "body": "try\n\t$end$\nexcept\n\ton E: $class:Exception$ do\n\t\t;\nend;" },
    { "abbreviation": "proc", "language": "pascal", "body": "procedure $name$($params$);\nbegin\n\t$end$\nend;" },
    { "abbreviation": "func", "language": "pascal", "body": "function $name$($params$): $type$;\nbegin\n\t$end$\nend;" },
    { "abbreviation": "class", "language": "pascal", "body": "$name:TMyClass$ = class($ancestor:TObject$)\nprivate\n\t$end$\npublic\nend;" },
    { "abbreviation": "wl", "language": "pascal", "body": "WriteLn($end$);" },
    { "abbreviation": "else", "language": "pascal", "body": "else\n\t$end$" },
    { "abbreviation": "elseb", "language": "pascal", "body": "else\nbegin\n\t$end$\nend;" },
    { "abbreviation": "ifeb", "language": "pascal", "body": "if $condition$ then\nbegin\n\t$end$\nend\nelse\nbegin\n\t\nend;" },
    { "abbreviation": "ifa", "language": "pascal", "body": "if Assigned($value$) then\n\t$end$" },
    { "abbreviation": "ifn", "language": "pascal", "body": "if $value$ = nil then\n\t$end$" },
    { "abbreviation": "fordown", "language": "pascal", "body": "for $i:I$ := $from$ downto $to:0$ do\n\t$end$" },
    { "abbreviation": "forinb", "language": "pascal", "body": "for $item$ in $collection$ do\nbegin\n\t$end$\nend;" },
    { "abbreviation": "forv", "language": "pascal", "body": "for var $i:I$ := $from:0$ to $to$ do\n\t$end$" },
    { "abbreviation": "forinv", "language": "pascal", "body": "for var $item$ in $collection$ do\n\t$end$" },
    { "abbreviation": "with", "language": "pascal", "body": "with $object$ do\nbegin\n\t$end$\nend;" },
    { "abbreviation": "tryef", "language": "pascal", "body": "try\n\ttry\n\t\t$end$\n\texcept\n\t\ton E: $class:Exception$ do\n\t\t\t;\n\tend;\nfinally\n\t$cleanup$;\nend;" },
    { "abbreviation": "raise", "language": "pascal", "body": "raise $class:Exception$.Create('$message$');" },
    { "abbreviation": "rec", "language": "pascal", "body": "$name:TMyRecord$ = record\n\t$end$\nend;" },
    { "abbreviation": "intf", "language": "pascal", "body": "$name:IMyInterface$ = interface\n\t$end$\nend;" },
    { "abbreviation": "enum", "language": "pascal", "body": "$name:TMyEnum$ = ($values$);" },
    { "abbreviation": "arr", "language": "pascal", "body": "array[$low:0$..$high$] of $type$$end$" },
    { "abbreviation": "const", "language": "pascal", "body": "const\n\t$name$ = $value$;" },
    { "abbreviation": "var", "language": "pascal", "body": "var\n\t$name$: $type$;" },
    { "abbreviation": "type", "language": "pascal", "body": "type\n\t$end$" },
    { "abbreviation": "ctor", "language": "pascal", "body": "constructor $class:=ClassName()$.Create;\nbegin\n\tinherited Create;\n\t$end$\nend;" },
    { "abbreviation": "dtor", "language": "pascal", "body": "destructor $class:=ClassName()$.Destroy;\nbegin\n\t$end$\n\tinherited;\nend;" },
    { "abbreviation": "procm", "language": "pascal", "body": "procedure $class:=ClassName()$.$name$($params$);\nbegin\n\t$end$\nend;" },
    { "abbreviation": "funcm", "language": "pascal", "body": "function $class:=ClassName()$.$name$($params$): $type$;\nbegin\n\t$end$\nend;" },
    { "abbreviation": "prop", "language": "pascal", "body": "property $name$: $type$ read F$name$ write F$name$;" },
    { "abbreviation": "propr", "language": "pascal", "body": "property $name$: $type$ read F$name$;" },
    { "abbreviation": "unit", "language": "pascal", "body": "unit $name:=UnitName()$;\n\ninterface\n\n$end$\n\nimplementation\n\nend." },
    { "abbreviation": "prog", "language": "pascal", "body": "program $name:=UnitName()$;\n\n{$$APPTYPE CONSOLE}\n\nbegin\n\t$end$\nend." },
    { "abbreviation": "region", "language": "pascal", "body": "{$$REGION '$name$'}\n$selection$$end$\n{$$ENDREGION}" },
    { "abbreviation": "todo", "language": "pascal", "body": "// TODO: $end$" },
    { "abbreviation": "hdr", "language": "pascal", "body": "// $unit:=UnitName()$ - $date:=Date()$$end$" },
    { "abbreviation": "wlf", "language": "pascal", "body": "WriteLn(Format('$format$', [$args$]));$end$" },
    { "abbreviation": "fan", "language": "pascal", "body": "FreeAndNil($object$);$end$" }
  ]
}
