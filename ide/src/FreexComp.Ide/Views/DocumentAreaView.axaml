<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FreexComp.Ide.Core.ViewModels;assembly=FreexComp.Ide.Core"
             xmlns:views="clr-namespace:FreexComp.Ide.Views"
             xmlns:ide="clr-namespace:FreexComp.Ide"
             x:Class="FreexComp.Ide.Views.DocumentAreaView"
             x:DataType="vm:DocumentAreaViewModel"
             AutomationProperties.AutomationId="{x:Static ide:AutomationIds.DocumentArea}"
             MinWidth="320" MinHeight="160" Focusable="True">
  <DockPanel>
    <!-- editor.md §8: the tab strip; the active document's view below it. -->
    <views:DocumentTabStrip DockPanel.Dock="Top" />
    <Panel>
      <ContentControl Content="{Binding ActiveDocument}" />
      <!-- UI-WIN-002 / UI-ED-080: empty state. -->
      <Border Background="{DynamicResource FxcBgSunkenBrush}" IsVisible="{Binding IsEmpty}"
              AutomationProperties.AutomationId="{x:Static ide:AutomationIds.DocumentAreaEmpty}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
          <TextBlock Classes="subtitle" HorizontalAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource FxcTextSecondaryBrush}" Text="{Binding EmptyHeading}" />
          <TextBlock Classes="body" HorizontalAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource FxcTextSecondaryBrush}" Text="{Binding EmptyHints}" />
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
