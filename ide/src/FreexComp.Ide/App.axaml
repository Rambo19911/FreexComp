<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FreexComp.Ide.Views"
             x:Class="FreexComp.Ide.App">
  <Application.Resources>
    <ResourceDictionary>
      <!-- UI-TOK-001: color tokens per theme variant; theme-independent tokens merged once. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="Light" Source="avares://FreexComp.Ide/Themes/Light.axaml" />
        <ResourceInclude x:Key="Dark" Source="avares://FreexComp.Ide/Themes/Dark.axaml" />
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FreexComp.Ide/Themes/Metrics.axaml" />
        <ResourceInclude Source="avares://FreexComp.Ide/Themes/FluentOverrides.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <!-- IDE-ARCH-014 -->
    <views:ViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <!-- UI-ED-001: the code editor's control templates (not forked). -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://FreexComp.Ide/Themes/TextStyles.axaml" />
    <!-- design-tokens.md §8 Tooltip: max width 480, padding 6 × 4; UI-TOK-051: fade-in 80 ms, the tooltip's only
         animation (I-246). A string tip wraps inside the width; a full path only after its separators (I-245,
         ToolTipText). The open delay of UI-TOK-052 is the default of every control (App). -->
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="{StaticResource FxcMetricTooltipMaxWidth}" />
      <Setter Property="Padding" Value="{StaticResource FxcMetricTooltipPadding}" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
        </Transitions>
      </Setter>
      <Setter Property="ContentTemplate">
        <views:ToolTipTemplate />
      </Setter>
    </Style>
    <!-- I-153: opening a menu or clicking a toolbar button takes focus; the TextBox keeps its selection so that
         Edit > Cut/Copy invoked by mouse still acts on it. -->
    <Style Selector="TextBox">
      <Setter Property="ClearSelectionOnLostFocus" Value="False" />
    </Style>
    <!-- design-tokens.md §9 Invalid state (UI-DLG-006): 1 px status.error border, also when hovered or focused. -->
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement, TextBox.invalid:pointerover /template/ Border#PART_BorderElement, TextBox.invalid:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource FxcStatusErrorBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- UI-ED-061: the editor's scrollbars are always shown (no auto-hide), 12 thick, without arrow buttons. -->
    <Style Selector="ScrollViewer.editorScroll ScrollBar">
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="ScrollViewer.editorScroll ScrollBar:vertical">
      <Setter Property="Width" Value="12" />
      <Setter Property="MinWidth" Value="12" />
    </Style>
    <Style Selector="ScrollViewer.editorScroll ScrollBar:horizontal">
      <Setter Property="Height" Value="12" />
      <Setter Property="MinHeight" Value="12" />
    </Style>
    <Style Selector="ScrollViewer.editorScroll ScrollBar /template/ RepeatButton#PART_LineUpButton, ScrollViewer.editorScroll ScrollBar /template/ RepeatButton#PART_LineDownButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- design-tokens.md §9 Selected / checked, toggle buttons (I-215): subtle bg.selected fill and a 1 px accent.default
         border instead of Fluent's accent fill, so status glyphs keep >= 3:1 contrast; text glyphs in text.primary. -->
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FxcBgSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FxcAccentDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource FxcTextPrimaryBrush}" />
    </Style>
    <!-- UI-TW-010: the selected row is bg.selected while its list has focus, bg.selected.inactive otherwise. -->
    <Style Selector="TreeView:not(:focus-within) TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource FxcBgSelectedInactiveBrush}" />
    </Style>
    <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FxcBgSelectedInactiveBrush}" />
    </Style>
  </Application.Styles>
</Application>
