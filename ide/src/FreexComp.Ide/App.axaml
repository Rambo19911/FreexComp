<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FreexComp.Ide.Views"
             x:Class="FreexComp.Ide.App">
  <Application.Resources>
    <ResourceDictionary>
      <!-- UI-TOK-001: color tokens per theme variant; theme-independent tokens merged once. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceInclude x:Key="Light" Source="avares://FreexComp.Ide/Themes/Light.axaml" />
        <ResourceInclude x:Key="Dark" Source="avares://FreexComp.Ide/Themes/Dark.axaml" />
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FreexComp.Ide/Themes/Metrics.axaml" />
        <ResourceInclude Source="avares://FreexComp.Ide/Themes/FluentOverrides.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <!-- IDE-ARCH-014 -->
    <views:ViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <!-- UI-ED-001: the code editor's control templates (not forked). -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://FreexComp.Ide/Themes/TextStyles.axaml" />
    <!-- I-153: opening a menu or clicking a toolbar button takes focus; the TextBox keeps its selection so that
         Edit > Cut/Copy invoked by mouse still acts on it. -->
    <Style Selector="TextBox">
      <Setter Property="ClearSelectionOnLostFocus" Value="False" />
    </Style>
  </Application.Styles>
</Application>
