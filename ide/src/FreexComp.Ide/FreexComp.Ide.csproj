<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>FreexComp.Ide</RootNamespace>
    <ApplicationIcon>..\..\..\assets\brand\app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FreexComp.Ide.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- BR-001: the brand icon, tracked in assets/brand, used for the executable and every window. -->
    <AvaloniaResource Include="..\..\..\assets\brand\app.ico" Link="Assets\app.ico" />
    <!-- UI-TOK-040: original icon geometry, read by Icons/IconCatalog. -->
    <AvaloniaResource Include="Assets\Icons\*.svg" />
    <!-- UI-ED-114 / UI-TW-203: original symbol-kind icons (same format), a set of their own. -->
    <AvaloniaResource Include="Assets\SymbolIcons\*.svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FreexComp.Ide.Core\FreexComp.Ide.Core.csproj" />
    <ProjectReference Include="..\FreexComp.Designer\FreexComp.Designer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <!-- F11-001: the IDE is a 64-bit application (ADR 002, ADR 007); a 32-bit or non-x64 build of it is refused. -->
  <Target Name="RequireX64Ide" BeforeTargets="BeforeBuild;Publish" Condition="('$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64') or ('$(PlatformTarget)' != '' and '$(PlatformTarget)' != 'AnyCPU' and '$(PlatformTarget)' != 'x64')">
    <Error Text="FreexComp.Ide is built for win-x64 only (RuntimeIdentifier '$(RuntimeIdentifier)', PlatformTarget '$(PlatformTarget)')." />
  </Target>
</Project>
