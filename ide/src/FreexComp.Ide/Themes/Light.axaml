<!-- Light theme: every color token of docs/spec/ui/design-tokens.md §2-§3 (UI-TOK-001/002). Keys: Fxc + PascalCase; <Key> = Color, <Key>Brush = SolidColorBrush. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 2.1 Surfaces and borders -->
  <Color x:Key="FxcBgWindow">#F3F4F2</Color>
  <SolidColorBrush x:Key="FxcBgWindowBrush" Color="#F3F4F2" />
  <Color x:Key="FxcBgPanel">#FAFAF8</Color>
  <SolidColorBrush x:Key="FxcBgPanelBrush" Color="#FAFAF8" />
  <Color x:Key="FxcBgEditor">#FFFFFF</Color>
  <SolidColorBrush x:Key="FxcBgEditorBrush" Color="#FFFFFF" />
  <Color x:Key="FxcBgGutter">#F6F7F5</Color>
  <SolidColorBrush x:Key="FxcBgGutterBrush" Color="#F6F7F5" />
