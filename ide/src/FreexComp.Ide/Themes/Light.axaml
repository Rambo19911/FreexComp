  <SolidColorBrush x:Key="FxcBgRaisedBrush" Color="#FFFFFF" />
  <Color x:Key="FxcBgSunken">#E9EBE7</Color>
  <SolidColorBrush x:Key="FxcBgSunkenBrush" Color="#E9EBE7" />
  <Color x:Key="FxcBgHeader">#ECEEEB</Color>
  <SolidColorBrush x:Key="FxcBgHeaderBrush" Color="#ECEEEB" />
