  <Color x:Key="FxcBgSelectedInactive">#E1E4DF</Color>
  <SolidColorBrush x:Key="FxcBgSelectedInactiveBrush" Color="#E1E4DF" />
  <Color x:Key="FxcBgOverlay">#661C211E</Color>
  <SolidColorBrush x:Key="FxcBgOverlayBrush" Color="#661C211E" />
  <Color x:Key="FxcBorderDefault">#C9CEC7</Color>
  <SolidColorBrush x:Key="FxcBorderDefaultBrush" Color="#C9CEC7" />
  <Color x:Key="FxcBorderSubtle">#DFE2DD</Color>
  <SolidColorBrush x:Key="FxcBorderSubtleBrush" Color="#DFE2DD" />
