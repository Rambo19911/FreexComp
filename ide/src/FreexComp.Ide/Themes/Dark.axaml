<!-- Dark theme: every color token of docs/spec/ui/design-tokens.md §2-§3 (UI-TOK-001/002). Keys: Fxc + PascalCase; <Key> = Color, <Key>Brush = SolidColorBrush. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 2.1 Surfaces and borders -->
  <Color x:Key="FxcBgWindow">#1B1F1D</Color>
  <SolidColorBrush x:Key="FxcBgWindowBrush" Color="#1B1F1D" />
  <Color x:Key="FxcBgPanel">#222725</Color>
  <SolidColorBrush x:Key="FxcBgPanelBrush" Color="#222725" />
  <Color x:Key="FxcBgEditor">#171A19</Color>
  <SolidColorBrush x:Key="FxcBgEditorBrush" Color="#171A19" />
