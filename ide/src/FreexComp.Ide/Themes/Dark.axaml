  <Color x:Key="FxcBgOverlay">#80000000</Color>
  <SolidColorBrush x:Key="FxcBgOverlayBrush" Color="#80000000" />
  <Color x:Key="FxcBorderDefault">#3A423E</Color>
  <SolidColorBrush x:Key="FxcBorderDefaultBrush" Color="#3A423E" />
  <Color x:Key="FxcBorderSubtle">#2D3330</Color>
  <SolidColorBrush x:Key="FxcBorderSubtleBrush" Color="#2D3330" />
