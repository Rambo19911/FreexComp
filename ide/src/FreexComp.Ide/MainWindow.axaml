<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FreexComp.Ide.Core.ViewModels;assembly=FreexComp.Ide.Core"
        xmlns:ide="clr-namespace:FreexComp.Ide"
        xmlns:views="clr-namespace:FreexComp.Ide.Views"
        x:Class="FreexComp.Ide.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://FreexComp.Ide/Assets/app.ico"
        AutomationProperties.AutomationId="{x:Static ide:AutomationIds.MainWindow}"
        Background="{DynamicResource FxcBgWindowBrush}"
        UseLayoutRounding="True"
        Width="1440" Height="900" MinWidth="800" MinHeight="500">
  <!-- main-window.md §1 regions 2-8. Phase 1: every dock is empty and therefore collapsed (UI-WIN-004, UI-WIN-011). -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- (2) Menu bar: items generated from the menu model (UI-MENU-002), see MainWindow.axaml.cs. -->
    <Menu x:Name="MenuBar" Grid.Row="0" Height="{DynamicResource FxcMetricMenuBarHeight}"
          AutomationProperties.AutomationId="{x:Static ide:AutomationIds.MenuBar}" />
    <!-- (3) Toolbar row: generated from the toolbar models (UI-TB-002), see MainWindow.axaml.cs. -->
    <views:ToolBarRow x:Name="ToolBars" Grid.Row="1" />
    <!-- (4)-(7) Docks around the document area, through the ViewLocator (LayoutView). -->
    <ContentControl Grid.Row="2" Content="{Binding Layout}" />
    <!-- (8) Status bar: fields in I-027. -->
    <DockPanel Grid.Row="3" Height="{DynamicResource FxcMetricStatusBarHeight}"
               Background="{DynamicResource FxcStatusbarIdleBgBrush}"
               AutomationProperties.AutomationId="{x:Static ide:AutomationIds.StatusBar}" />
  </Grid>
</Window>
