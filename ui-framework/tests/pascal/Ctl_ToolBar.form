object BarForm: TBarForm
  Caption = 'Bar'
  ClientWidth = 400
  ClientHeight = 300
  Scaled = False
  object Bar: TToolBar
    Left = 0
    Top = 0
    Width = 400
    Height = 36
    ButtonHeight = 26
    ButtonWidth = 30
    Indent = 4
    List = True
    ShowCaptions = True
    object New: TToolButton
      Caption = '&New'
      Hint = 'Creates'
      ImageIndex = 2
      OnClick = NewClick
    end
    object Sep: TToolButton
      Width = 6
      Style = tbsSeparator
    end
    object Opt: TToolButton
      Caption = 'Opt'
      Down = True
      Grouped = True
      Style = tbsCheck
    end
    object Box: TPanel
      Left = 0
      Top = 0
      Width = 50
      Height = 20
    end
  end
end
