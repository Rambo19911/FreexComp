object EditForm: TEditForm
  Caption = 'Edits'
  ClientWidth = 400
  ClientHeight = 300
  Scaled = False
  object Auto: TEdit
    Left = 10
    Top = 10
    Width = 121
    Height = 40
    Alignment = taRightJustify
    AutoSelect = False
    Font.Height = -16
    ParentFont = False
