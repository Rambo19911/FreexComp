  end
  object Other: TEdit
    Left = 10
    Top = 60
    Width = 121
    Height = 40
    AutoSize = False
    BorderStyle = bsNone
    CharCase = ecLowerCase
    Color = clYellow
    HideSelection = False
    MaxLength = 8
    NumbersOnly = True
    PasswordChar = '*'
    ReadOnly = True
    TabStop = False
    Text = 'abc'
    TextHint = 'hint'
    OnChange = OtherChange
  end
end
