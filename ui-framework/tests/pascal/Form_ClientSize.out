# without a handle (UIF-273)
ok a sizeable form has a frame
ok ClientWidth
ok ClientHeight
ok Width = client + frame
ok Height = client + frame
ok Width := V sets ClientWidth := V - frame
ok Height := V sets ClientHeight := V - frame
ok ClientWidth := V: Width follows
ok BorderStyle change keeps ClientWidth
ok BorderStyle change keeps ClientHeight
ok bsNone: no frame
ok bsDialog frame
ok bsDialog frame height
