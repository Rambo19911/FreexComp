ok main form window created lazily
ok main form without handle: no owner
ok main form: WS_EX_APPWINDOW
ok main form: no owner
ok other form: no WS_EX_APPWINDOW
ok other form: owned by the main form
ok OnDestroy fired
ok destroyed main form: MainForm nil
