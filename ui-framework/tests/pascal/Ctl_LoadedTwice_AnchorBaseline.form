object AnchorForm: TAnchorForm
  ClientWidth = 600
  ClientHeight = 400
  Scaled = False
  inline Wide: TAnchorFrame
    Left = 0
    Top = 0
    Width = 400
    Height = 120
    TabOrder = 0
    inherited RightB: TPanel
      Caption = 'reached'
    end
    inherited RightC: TPanel
      Left = 100
    end
    inherited Stretch: TPanel
      Caption = 'reached'
    end
  end
  inline Same: TAnchorFrame
    Left = 0
    Top = 200
    TabOrder = 1
    inherited RightB: TPanel
      Caption = 'reached'
    end
    inherited Stretch: TPanel
      Caption = 'reached'
    end
  end
end
