object PageForm: TPageForm
  ClientWidth = 400
  ClientHeight = 400
  Scaled = False
  inline Keep: TPageFrame
    Left = 0
    Top = 0
    TabOrder = 0
    inherited PC: TPageControl
      Tag = 1
    end
  end
  inline Switch: TPageFrame
    Left = 0
    Top = 200
    TabOrder = 1
    inherited PC: TPageControl
      ActivePage = Page3
      inherited Page3: TTabSheet
        Caption = 'Third'
      end
    end
  end
  inline Plain: TPageFrame
    Left = 0
    Top = 400
    TabOrder = 2
  end
end
