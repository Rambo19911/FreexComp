* text=auto eol=lf
*.png binary
*.ico binary
*.ps1 text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
# licence files with fixed LF line endings (compared byte for byte by the policy tests)
LICENSE-RUNTIME text eol=lf
