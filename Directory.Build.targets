<Project>
  <!--
    No network during builds (ADR 008): the Avalonia packages pull in Avalonia.BuildServices, whose
    "AvaloniaStats" target runs a build-statistics task before CoreCompile. Redefining the target here
    (imported after the package targets) replaces it with an empty one, so the task never runs.
  -->
  <Target Name="AvaloniaStats" />

  <!--
    Pages shipped next to the tools: building the IDE or a command-line tool copies them from the repository root
    to its output directory. Libraries and test projects do not get them.
  -->
  <Target Name="CopyProductPages" AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'FreexComp.Ide' or '$(MSBuildProjectName)' == 'opc' or '$(MSBuildProjectName)' == 'pbuild' or '$(MSBuildProjectName)' == 'prc'">
    <Error Condition="!Exists('$(RepoRoot)NETWORK-POLICY.md')" Text="Policy file 'NETWORK-POLICY.md' is missing in the repository root." />
    <Copy SourceFiles="$(RepoRoot)NETWORK-POLICY.md" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Licence files shipped next to the tools: the four root files are copied to <output>/licenses/.
    Libraries and test projects do not get the folder.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'FreexComp.Ide' or '$(MSBuildProjectName)' == 'opc' or '$(MSBuildProjectName)' == 'pbuild' or '$(MSBuildProjectName)' == 'prc'">
    <ProductLicenseFile Include="LICENSE;LICENSE-RUNTIME;NOTICE;THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
  <Target Name="CopyLicenseFiles" AfterTargets="Build" Condition="'@(ProductLicenseFile)' != ''">
    <Error Condition="!Exists('$(RepoRoot)%(ProductLicenseFile.Identity)')"
           Text="License file '%(ProductLicenseFile.Identity)' is missing in the repository root." />
    <Copy SourceFiles="@(ProductLicenseFile->'$(RepoRoot)%(Identity)')" DestinationFolder="$(OutDir)licenses" SkipUnchangedFiles="true" />
  </Target>
</Project>
