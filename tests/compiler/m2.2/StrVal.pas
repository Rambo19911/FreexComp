// covers: LANG-950, LANG-951
program StrVal;
var
  S: string;
  I, Code: Integer;
  B: Byte;
  W: Word;
  Q: Int64;
  U: UInt64;
  C: Cardinal;
  D: Double;
  F: Single;
begin
  Str(42, S);          Writeln('[', S, ']');
  Str(-7:5, S);        Writeln('[', S, ']');
  Str(123:2, S);       Writeln('[', S, ']');
  Q := Low(Int64);
  Str(Q, S);           Writeln(S);
  U := High(UInt64);
  Str(U, S);           Writeln(S);
  C := 4000000000;
  Str(C:12, S);        Writeln('[', S, ']');
  D := 1.5;
  Str(D, S);           Writeln('[', S, ']');
  Str(D:10, S);        Writeln('[', S, ']');
  Str(3.14159:8:2, S); Writeln('[', S, ']');
  Str(-0.005:0:2, S);  Writeln('[', S, ']');
  F := 0.25;
  Str(F:0:3, S);       Writeln(S);

  Val('123', I, Code);                   Writeln(I, ' ', Code);
  Val('  -45', I, Code);                 Writeln(I, ' ', Code);
  Val('+7', I, Code);                    Writeln(I, ' ', Code);
  Val('$1F', I, Code);                   Writeln(I, ' ', Code);
  Val('0x1f', I, Code);                  Writeln(I, ' ', Code);
  Val('-$10', I, Code);                  Writeln(I, ' ', Code);
  Val('12a', I, Code);                   Writeln(I, ' ', Code);
  Val('', I, Code);                      Writeln(I, ' ', Code);
  Val('   ', I, Code);                   Writeln(I, ' ', Code);
  Val('-', I, Code);                     Writeln(I, ' ', Code);
  Val('12 ', I, Code);                   Writeln(I, ' ', Code);
  Val(' 1 2', I, Code);                  Writeln(I, ' ', Code);
  Val('$', I, Code);                     Writeln(I, ' ', Code);
  Val('$G', I, Code);                    Writeln(I, ' ', Code);
  Val('2147483647', I, Code);            Writeln(I, ' ', Code);
  Val('2147483648', I, Code);            Writeln(I, ' ', Code);
  Val('-2147483648', I, Code);           Writeln(I, ' ', Code);
  Val('256', B, Code);                   Writeln(B, ' ', Code);
  Val('255', B, Code);                   Writeln(B, ' ', Code);
  Val('-1', B, Code);                    Writeln(B, ' ', Code);
  Val('-1', W, Code);                    Writeln(W, ' ', Code);
  Val('9223372036854775807', Q, Code);   Writeln(Q, ' ', Code);
  Val('-9223372036854775808', Q, Code);  Writeln(Q, ' ', Code);
  Val('9223372036854775808', Q, Code);   Writeln(Q, ' ', Code);
  Val('18446744073709551615', U, Code);  Writeln(U, ' ', Code);
  Val('18446744073709551616', U, Code);  Writeln(U, ' ', Code);
  Val('4294967295', C, Code);            Writeln(C, ' ', Code);
  Val('3.5', D, Code);                   Writeln(D:0:2, ' ', Code);
  Val(' -0.25e1', D, Code);              Writeln(D:0:2, ' ', Code);
  Val('1E3', D, Code);                   Writeln(D:0:1, ' ', Code);
  Val('1.', D, Code);                    Writeln(D:0:1, ' ', Code);
  Val('1.5x', D, Code);                  Writeln(D:0:1, ' ', Code);
  Val('inf', D, Code);                   Writeln(D:0:1, ' ', Code);
  Val('-INF', D, Code);                  Writeln(D:0:1, ' ', Code);
  Val('NaN', D, Code);                   Writeln(D:0:1, ' ', Code);
  Val('2.5', F, Code);                   Writeln(F:0:1, ' ', Code);
  S := '77';
  Val(S + '1', I, Code);                 Writeln(I, ' ', Code);
end.
