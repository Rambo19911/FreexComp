    <!-- The process-leak check is the same in both debugger test projects (debugger testing DBG-334). -->
    <Compile Include="..\FreexComp.Debugger.Tests\TestSupport\ProcessLeakFixture.cs" Link="TestSupport\ProcessLeakFixture.cs" />
  </ItemGroup>
</Project>
