    <ProjectReference Include="..\..\src\FreexComp.Debugger\FreexComp.Debugger.csproj" />
    <!-- Build order only: the tests run the Pascal compiler's built output as a tool (scripted test DBG-301). -->
    <ProjectReference Include="..\..\..\compiler\src\opc\opc.csproj" ReferenceOutputAssembly="false" />
    <!-- The console helper modes of the terminal-mode tests (FakeAdapter.exe is copied next to the test assembly; it is
