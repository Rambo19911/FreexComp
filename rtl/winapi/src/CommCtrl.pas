implementation

function LPSTR_TEXTCALLBACKW: LPWSTR;
begin
  Result := LPWSTR(-1);
end;

function LPSTR_TEXTCALLBACK: LPWSTR;
begin
  Result := LPWSTR(-1);
end;

function IndexToStateImageMask(I: UINT): UINT;
begin
  Result := I shl 12;
end;

function IndexToOverlayMask(I: UINT): UINT;
begin
  Result := I shl 8;
end;

function ImageList_AddIcon(himl: HIMAGELIST; Icon: HICON): Integer;
begin
  Result := ImageList_ReplaceIcon(himl, -1, Icon);
end;

end.
