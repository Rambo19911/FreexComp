// covers: RTL-079
program Sys_ValFloat;
{ Val for reals (_ValFloat, LANG-943): correctly rounded (half-even) to the nearest Double, shown as the bit pattern
  and Code. The expected patterns come from an independent correctly rounded converter (frozen in the .out): hard
  cases (midpoints between neighbouring Doubles exactly and just above/below, subnormals, the overflow boundary,
  texts longer than the kept digits), random texts, special values and syntax errors with their Code. }
type
  PBits = ^UInt64;

procedure WriteHex(U: UInt64);
var
  K: Integer;
  D: Cardinal;
begin
  for K := 15 downto 0 do
  begin
    D := (U shr (K * 4)) and 15;
    if D < 10 then
      Write(Chr(48 + D))
    else
      Write(Chr(55 + D));
  end;
end;

procedure T(const S: string);
var
  D: Double;
  Code: Integer;
begin
  Val(S, D, Code);
  WriteHex(PBits(@D)^);
  Writeln(' ', Code);
end;

