// The resources of the golden test Win_ResourceLanguage: one RCDATA number in two languages, and a string table.
#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
1 RCDATA BEGIN "en" END

LANGUAGE LANG_GERMAN, SUBLANG_GERMAN
1 RCDATA BEGIN "de" END

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
STRINGTABLE
BEGIN
  7 "seven"
  20 "twenty"
END
