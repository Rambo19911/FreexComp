{ Character - classification of UTF-16 code units and code points without OS calls (docs: rtl/other-units.md
  section 5, RTL-640, RTL-1278). The category table (CharTables.inc) is generated by rtl/tools/GenCharTables.cs from
  UnicodeData.txt of the Unicode Character Database (the version is recorded at the top of CharTables.inc). The
  forms with one Char classify that code unit, so a surrogate code unit is never a letter, digit etc.; the one-based
  (S, Index) forms classify the code point at S[Index] - a surrogate pair as its code point (supplementary planes
  included), any other code unit as itself. Case mapping is the simple one-to-one mapping of that file, owned by
  SysUtils (SimpleUpperCase / SimpleLowerCase, AnsiUpperCase / AnsiLowerCase, RTL-1276): no locale rules, so
  ToLower(U+0130) = 'i' and ToUpper(U+0131) = 'I', and nothing that changes the number of code units. }
unit Character;

interface

uses
  SysUtils, RTLConsts;

type
  { the 30 Unicode general categories, in the order of the generated tables }
  TUnicodeCategory = (
    ucUppercaseLetter, ucLowercaseLetter, ucTitlecaseLetter, ucModifierLetter, ucOtherLetter,
    ucNonSpacingMark, ucCombiningMark, ucEnclosingMark,
    ucDecimalNumber, ucLetterNumber, ucOtherNumber,
    ucSpaceSeparator, ucLineSeparator, ucParagraphSeparator,
    ucControl, ucFormat, ucSurrogate, ucPrivateUse,
    ucConnectPunctuation, ucDashPunctuation, ucOpenPunctuation, ucClosePunctuation, ucInitialPunctuation,
    ucFinalPunctuation, ucOtherPunctuation,
    ucMathSymbol, ucCurrencySymbol, ucModifierSymbol, ucOtherSymbol,
    ucUnassigned);

function GetUnicodeCategory(C: Char): TUnicodeCategory; overload;
{ L* }
function IsLetter(C: Char): Boolean; overload;
{ Nd }
function IsDigit(C: Char): Boolean; overload;
function IsLetterOrDigit(C: Char): Boolean; overload;
{ Z*, and the controls U+0009 .. U+000D and U+0085 }
function IsWhiteSpace(C: Char): Boolean; overload;
{ Lu / Ll / Cc }
function IsUpper(C: Char): Boolean; overload;
function IsLower(C: Char): Boolean; overload;
function IsControl(C: Char): Boolean; overload;
{ P* / S* / Z* / N* }
function IsPunctuation(C: Char): Boolean; overload;
function IsSymbol(C: Char): Boolean; overload;
function IsSeparator(C: Char): Boolean; overload;
function IsNumber(C: Char): Boolean; overload;
{ D800 - DBFF / DC00 - DFFF }
function IsHighSurrogate(C: Char): Boolean; overload;
function IsLowSurrogate(C: Char): Boolean; overload;
function IsSurrogate(C: Char): Boolean; overload;
function IsSurrogatePair(Hi, Lo: Char): Boolean; overload;
function ToUpper(C: Char): Char; overload;
function ToUpper(const S: string): string; overload;
function ToLower(C: Char): Char; overload;
function ToLower(const S: string): string; overload;
{ C > U+10FFFF or a surrogate code point raises EArgumentOutOfRangeException }
function ConvertFromUtf32(C: Cardinal): string;
{ the code point at S[Index] (1-based; a surrogate pair counts as one); an index outside S, a low surrogate or an
  unpaired high surrogate raises EArgumentOutOfRangeException }
function ConvertToUtf32(const S: string; Index: Integer): Cardinal; overload;

{ RTL-1278: the one-based (S, Index) forms. Index < 1 or Index > Length(S) raises EArgumentOutOfRangeException. The
  category and the eleven classes are those of the code point at Index: the code point of the pair when S[Index] is a
  high surrogate followed by a low one, else the code unit S[Index] itself (a lone surrogate is ucSurrogate). }
function GetUnicodeCategory(const S: string; Index: Integer): TUnicodeCategory; overload;
function IsLetter(const S: string; Index: Integer): Boolean; overload;
function IsDigit(const S: string; Index: Integer): Boolean; overload;
function IsLetterOrDigit(const S: string; Index: Integer): Boolean; overload;
function IsWhiteSpace(const S: string; Index: Integer): Boolean; overload;
function IsUpper(const S: string; Index: Integer): Boolean; overload;
function IsLower(const S: string; Index: Integer): Boolean; overload;
function IsControl(const S: string; Index: Integer): Boolean; overload;
function IsPunctuation(const S: string; Index: Integer): Boolean; overload;
function IsSymbol(const S: string; Index: Integer): Boolean; overload;
function IsSeparator(const S: string; Index: Integer): Boolean; overload;
function IsNumber(const S: string; Index: Integer): Boolean; overload;
{ the code unit S[Index] }
function IsHighSurrogate(const S: string; Index: Integer): Boolean; overload;
function IsLowSurrogate(const S: string; Index: Integer): Boolean; overload;
function IsSurrogate(const S: string; Index: Integer): Boolean; overload;
{ S[Index] is a high and S[Index + 1] a low surrogate (False at the last index) }
function IsSurrogatePair(const S: string; Index: Integer): Boolean; overload;
{ ConvertToUtf32(S, Index) with CharLength = the number of code units of that code point (2 for a pair, else 1) }
function ConvertToUtf32(const S: string; Index: Integer; out CharLength: Integer): Cardinal; overload;
{ the code point of a surrogate pair; arguments that are no pair raise EArgumentOutOfRangeException }
function ConvertToUtf32(HighSurrogate, LowSurrogate: Char): Cardinal; overload;

implementation

{$I CharTables.inc}

const
  CharBlockMask = (1 shl CharBlockShift) - 1;

procedure OutOfRange;
begin
  raise EArgumentOutOfRangeException.Create(SArgumentOutOfRange);
end;

function GetUnicodeCategory(C: Char): TUnicodeCategory;
var
  U: Integer;
begin
  U := Ord(C);
  Result := TUnicodeCategory(CatBlocks[CatBlockIndex[U shr CharBlockShift] shl CharBlockShift + U and CharBlockMask]);
end;

{ the category of a code point: the BMP from the two-level table, U+10000 .. U+10FFFF from the runs (each entry is
  its first code point shl 5 or the category; the last entry whose start is not above CodePoint holds it) }
function CategoryOf(CodePoint: Cardinal): TUnicodeCategory;
var
  L, H, M: Integer;
  Key: Cardinal;
begin
  if CodePoint <= $FFFF then
    Result := GetUnicodeCategory(Char(CodePoint))
  else if CodePoint > $10FFFF then
    Result := ucUnassigned
  else
  begin
    Key := CodePoint shl 5 or 31;
    L := 0;
    H := CatRunCount - 1;
    while L < H do
    begin
      M := (L + H + 1) shr 1;
      if CatRuns[M] <= Key then
        L := M
      else
        H := M - 1;
    end;
    Result := TUnicodeCategory(CatRuns[L] and 31);
  end;
end;

{ RTL-1278 (a), (b): the code point at S[Index] }
function CodePointAt(const S: string; Index: Integer): Cardinal;
begin
  if (Index < 1) or (Index > Length(S)) then
    OutOfRange;
  Result := Ord(S[Index]);
  if (Result >= $D800) and (Result <= $DBFF) and (Index < Length(S)) and (S[Index + 1] >= #$DC00)
    and (S[Index + 1] <= #$DFFF) then
    Result := $10000 + (Result - $D800) shl 10 + (Cardinal(Ord(S[Index + 1])) - $DC00);
end;

function CategoryAt(const S: string; Index: Integer): TUnicodeCategory;
begin
  Result := CategoryOf(CodePointAt(S, Index));
end;

{ RTL-1278 (a) for the tests of the code unit S[Index] }
function UnitAt(const S: string; Index: Integer): Char;
begin
  if (Index < 1) or (Index > Length(S)) then
    OutOfRange;
  Result := S[Index];
end;

function IsLetter(C: Char): Boolean;
begin
  Result := GetUnicodeCategory(C) <= ucOtherLetter;
end;

function IsDigit(C: Char): Boolean;
begin
  Result := GetUnicodeCategory(C) = ucDecimalNumber;
end;

function IsLetterOrDigit(C: Char): Boolean;
var
  K: TUnicodeCategory;
begin
  K := GetUnicodeCategory(C);
  Result := (K <= ucOtherLetter) or (K = ucDecimalNumber);
end;

function IsSeparator(C: Char): Boolean;
var
  K: TUnicodeCategory;
begin
  K := GetUnicodeCategory(C);
  Result := (K >= ucSpaceSeparator) and (K <= ucParagraphSeparator);
end;

function IsWhiteSpace(C: Char): Boolean;
begin
  Result := ((C >= #9) and (C <= #13)) or (C = #$0085) or IsSeparator(C);
end;

function IsUpper(C: Char): Boolean;
begin
  Result := GetUnicodeCategory(C) = ucUppercaseLetter;
end;

function IsLower(C: Char): Boolean;
begin
  Result := GetUnicodeCategory(C) = ucLowercaseLetter;
end;

function IsControl(C: Char): Boolean;
begin
  Result := GetUnicodeCategory(C) = ucControl;
end;

function IsPunctuation(C: Char): Boolean;
var
  K: TUnicodeCategory;
begin
  K := GetUnicodeCategory(C);
  Result := (K >= ucConnectPunctuation) and (K <= ucOtherPunctuation);
end;

function IsSymbol(C: Char): Boolean;
var
  K: TUnicodeCategory;
begin
  K := GetUnicodeCategory(C);
  Result := (K >= ucMathSymbol) and (K <= ucOtherSymbol);
end;

function IsNumber(C: Char): Boolean;
var
  K: TUnicodeCategory;
begin
  K := GetUnicodeCategory(C);
  Result := (K >= ucDecimalNumber) and (K <= ucOtherNumber);
end;

function IsHighSurrogate(C: Char): Boolean;
begin
  Result := (C >= #$D800) and (C <= #$DBFF);
end;

function IsLowSurrogate(C: Char): Boolean;
begin
  Result := (C >= #$DC00) and (C <= #$DFFF);
end;

function IsSurrogate(C: Char): Boolean;
begin
  Result := (C >= #$D800) and (C <= #$DFFF);
end;

function IsSurrogatePair(Hi, Lo: Char): Boolean;
begin
  Result := IsHighSurrogate(Hi) and IsLowSurrogate(Lo);
end;

{ RTL-1276 (d): the case mapping is SysUtils' }
function ToUpper(C: Char): Char;
begin
  Result := Char(SimpleUpperCase(Ord(C)));
end;

function ToLower(C: Char): Char;
begin
  Result := Char(SimpleLowerCase(Ord(C)));
end;

function ToUpper(const S: string): string;
begin
  Result := AnsiUpperCase(S);
end;

function ToLower(const S: string): string;
begin
  Result := AnsiLowerCase(S);
end;

function ConvertFromUtf32(C: Cardinal): string;
begin
  if (C > $10FFFF) or ((C >= $D800) and (C <= $DFFF)) then
    OutOfRange;
  if C < $10000 then
    Result := Char(C)
  else
  begin
    C := C - $10000;
    Result := Char($D800 + C shr 10) + Char($DC00 + C and $3FF);
  end;
end;

function ConvertToUtf32(const S: string; Index: Integer): Cardinal;
begin
  if (Index < 1) or (Index > Length(S)) or IsLowSurrogate(S[Index]) then
    OutOfRange;
  if IsHighSurrogate(S[Index]) then
  begin
    if (Index = Length(S)) or not IsLowSurrogate(S[Index + 1]) then
      OutOfRange;
    Result := $10000 + (Cardinal(Ord(S[Index])) - $D800) shl 10 + (Cardinal(Ord(S[Index + 1])) - $DC00);
  end
  else
    Result := Ord(S[Index]);
end;

{ ------------------------------------------------------------------------- (S, Index) forms (RTL-1278, task R-267) }

function GetUnicodeCategory(const S: string; Index: Integer): TUnicodeCategory;
begin
  Result := CategoryAt(S, Index);
end;

function IsLetter(const S: string; Index: Integer): Boolean;
begin
  Result := CategoryAt(S, Index) <= ucOtherLetter;
end;

function IsDigit(const S: string; Index: Integer): Boolean;
begin
  Result := CategoryAt(S, Index) = ucDecimalNumber;
end;

function IsLetterOrDigit(const S: string; Index: Integer): Boolean;
var
  K: TUnicodeCategory;
begin
  K := CategoryAt(S, Index);
  Result := (K <= ucOtherLetter) or (K = ucDecimalNumber);
end;

{ the white-space controls are BMP code units: a supplementary code point is white space when it is a separator }
function IsWhiteSpace(const S: string; Index: Integer): Boolean;
var
  C: Cardinal;
  K: TUnicodeCategory;
begin
  C := CodePointAt(S, Index);
  if C <= $FFFF then
    Result := IsWhiteSpace(Char(C))
  else
  begin
    K := CategoryOf(C);
    Result := (K >= ucSpaceSeparator) and (K <= ucParagraphSeparator);
  end;
end;

function IsUpper(const S: string; Index: Integer): Boolean;
begin
  Result := CategoryAt(S, Index) = ucUppercaseLetter;
end;

function IsLower(const S: string; Index: Integer): Boolean;
begin
  Result := CategoryAt(S, Index) = ucLowercaseLetter;
end;

function IsControl(const S: string; Index: Integer): Boolean;
begin
  Result := CategoryAt(S, Index) = ucControl;
end;

function IsPunctuation(const S: string; Index: Integer): Boolean;
var
  K: TUnicodeCategory;
begin
  K := CategoryAt(S, Index);
  Result := (K >= ucConnectPunctuation) and (K <= ucOtherPunctuation);
end;

function IsSymbol(const S: string; Index: Integer): Boolean;
var
  K: TUnicodeCategory;
begin
  K := CategoryAt(S, Index);
  Result := (K >= ucMathSymbol) and (K <= ucOtherSymbol);
end;

function IsSeparator(const S: string; Index: Integer): Boolean;
var
  K: TUnicodeCategory;
begin
  K := CategoryAt(S, Index);
  Result := (K >= ucSpaceSeparator) and (K <= ucParagraphSeparator);
end;

function IsNumber(const S: string; Index: Integer): Boolean;
var
  K: TUnicodeCategory;
begin
  K := CategoryAt(S, Index);
  Result := (K >= ucDecimalNumber) and (K <= ucOtherNumber);
end;

function IsHighSurrogate(const S: string; Index: Integer): Boolean;
begin
  Result := IsHighSurrogate(UnitAt(S, Index));
end;

function IsLowSurrogate(const S: string; Index: Integer): Boolean;
begin
  Result := IsLowSurrogate(UnitAt(S, Index));
end;

function IsSurrogate(const S: string; Index: Integer): Boolean;
begin
  Result := IsSurrogate(UnitAt(S, Index));
end;

function IsSurrogatePair(const S: string; Index: Integer): Boolean;
begin
  Result := IsHighSurrogate(UnitAt(S, Index)) and (Index < Length(S)) and IsLowSurrogate(S[Index + 1]);
end;

function ConvertToUtf32(const S: string; Index: Integer; out CharLength: Integer): Cardinal;
begin
  Result := ConvertToUtf32(S, Index);
  if Result > $FFFF then
    CharLength := 2
  else
    CharLength := 1;
end;

function ConvertToUtf32(HighSurrogate, LowSurrogate: Char): Cardinal;
begin
  if not IsSurrogatePair(HighSurrogate, LowSurrogate) then
    OutOfRange;
  Result := $10000 + (Cardinal(Ord(HighSurrogate)) - $D800) shl 10 + (Cardinal(Ord(LowSurrogate)) - $DC00);
end;

end.
