== text: Text := on every field class
s: Text := 'text' -> vkString text
s: Text := '' -> vkString 
s: Text := '?' -> vkString ?
m: Text := 'memo' -> vkString memo
m: Text := '' -> vkString 
m: Text := '?' -> vkString ?
i: Text := '12' -> vkInt 12
i: Text := '' -> vkNull
i: Text := '?' -> E: '?' is not a valid integer value for field 'i'
a: Text := '13' -> vkInt 13
a: Text := '' -> vkNull
a: Text := '?' -> E: '?' is not a valid integer value for field 'a'
l: Text := '9000000001' -> vkInt 9000000001
l: Text := '' -> vkNull
l: Text := '?' -> E: '?' is not a valid integer value for field 'l'
f: Text := '1.5' -> vkFloat 1.5
f: Text := '' -> vkNull
f: Text := '?' -> E: '?' is not a valid floating-point value for field 'f'
c: Text := '-2.25' -> vkFloat -2.25
c: Text := '' -> vkNull
c: Text := '?' -> E: '?' is not a valid floating-point value for field 'c'
b: Text := 'false' -> vkInt 0
b: Text := '' -> vkNull
b: Text := '?' -> E: '?' is not a valid boolean value for field 'b'
