ok <`col:no` = :yes>
ok <[col:no] = :yes>
ok <a = :p -- :no~AND b = :q>
ok <a = :p -- :no>
ok <a = :p /* :no~:no */ AND b = :q>
ok <a = :p /* :no>
ok </* ' */ :p>
ok <'/*' :p>
ok <-- ' :no~~:p>
== ParseSQL: double colon
ok <SELECT a::text, :p>
ok <a:::p>
ok <a:: :p>
== ParseSQL: rebuilding the collection
ok a new collection is empty
ok the text is returned unchanged
ok DoCreate = False creates nothing
ok DoCreate = True creates the parameters
ok DoCreate = False leaves the collection
ok rebuilt in the order of first occurrence
ok a new parameter is unbound
ok a parameter of the same name keeps type and state
ok and its value
ok whatever the case of the name
ok a parameter that is no longer named is removed
ok the kept parameter is the same object
ok no parameters in the text: empty
== lookup
ok ParamByName ignores case
ok FindParam ignores case
ok FindParam: nil when missing
ok ParamByName: missing
