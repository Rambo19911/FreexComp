        { "name": "WantTabs", "type": "Boolean", "default": false, "category": "Behavior" },
        { "name": "WordWrap", "type": "Boolean", "default": true, "category": "Appearance" }
      ],
      "events": [
        { "name": "OnChange", "signature": "TNotifyEvent", "default": true },
        { "name": "OnClick", "signature": "TNotifyEvent" },
        { "name": "OnEnter", "signature": "TNotifyEvent" },
        { "name": "OnExit", "signature": "TNotifyEvent" },
        { "name": "OnKeyDown", "signature": "TKeyEvent" },
        { "name": "OnKeyPress", "signature": "TKeyPressEvent" },
        { "name": "OnKeyUp", "signature": "TKeyEvent" }
      ]
    },
