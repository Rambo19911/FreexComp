      "palette": { "page": "Data Controls", "order": 40, "icon": "icons/TDBEdit.svg" },
      "kind": "wincontrol",
      "defaultSize": { "width": 121, "height": 23 },
      "namePrefix": "DBEdit",
      "acceptsChildren": false,
      "renderer": "edit",
      "properties": [
        { "name": "DataSource", "type": "TDataSource", "kind": "component", "category": "Data" },
        { "name": "DataField", "type": "string", "default": "", "category": "Data", "editor": "fieldname", "editorOptions": { "dataSource": "DataSource" } },
        { "name": "ReadOnly", "type": "Boolean", "default": false, "category": "Behavior" },
        { "name": "AutoSelect", "type": "Boolean", "default": true, "category": "Behavior" },
        { "name": "CharCase", "type": "TEditCharCase", "default": "ecNormal", "category": "Appearance" },
        { "name": "Color", "type": "TColor", "default": "clWindow", "category": "Appearance", "editor": "color" },
        { "name": "Font", "type": "TFont", "kind": "object", "category": "Appearance", "editor": "font", "affectsLayout": true },
        { "name": "MaxLength", "type": "Integer", "default": 0, "category": "Behavior" },
        { "name": "PasswordChar", "type": "Char", "default": "", "category": "Appearance" },
        { "name": "TabOrder", "type": "Integer", "default": -1, "category": "Behavior", "min": -1, "max": 32767 },
        { "name": "TabStop", "type": "Boolean", "default": true, "category": "Behavior" }
      ],
      "events": [
        { "name": "OnChange", "signature": "TNotifyEvent", "default": true },
        { "name": "OnClick", "signature": "TNotifyEvent" },
        { "name": "OnEnter", "signature": "TNotifyEvent" },
        { "name": "OnExit", "signature": "TNotifyEvent" },
        { "name": "OnKeyDown", "signature": "TKeyEvent" },
        { "name": "OnKeyPress", "signature": "TKeyPressEvent" },
        { "name": "OnKeyUp", "signature": "TKeyEvent" }
      ]
    },
