      "defaultSize": { "width": 145, "height": 23 },
      "namePrefix": "DBLookupComboBox",
      "acceptsChildren": false,
      "renderer": "combobox",
      "properties": [
        { "name": "DataSource", "type": "TDataSource", "kind": "component", "category": "Data" },
        { "name": "DataField", "type": "string", "default": "", "category": "Data", "editor": "fieldname", "editorOptions": { "dataSource": "DataSource" } },
