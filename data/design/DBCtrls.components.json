        { "name": "Font", "type": "TFont", "kind": "object", "category": "Appearance", "editor": "font", "affectsLayout": true },
        { "name": "TabOrder", "type": "Integer", "default": -1, "category": "Behavior", "min": -1, "max": 32767 },
        { "name": "TabStop", "type": "Boolean", "default": true, "category": "Behavior" }
      ],
      "events": [
        { "name": "OnClick", "signature": "TNotifyEvent", "default": true },
        { "name": "OnDropDown", "signature": "TNotifyEvent" }
      ]
    },
    {
      "class": "TDBNavigator",
      "ancestor": "TCustomControl",
      "abstract": false,
      "palette": { "page": "Data Controls", "order": 20, "icon": "icons/TDBNavigator.svg" },
      "kind": "wincontrol",
      "defaultSize": { "width": 240, "height": 25 },
      "namePrefix": "DBNavigator",
      "acceptsChildren": false,
      "renderer": "dbnavigator",
      "properties": [
        { "name": "DataSource", "type": "TDataSource", "kind": "component", "category": "Data" },
        { "name": "VisibleButtons", "type": "TNavButtonSet", "default": ["nbFirst", "nbPrior", "nbNext", "nbLast", "nbInsert", "nbDelete", "nbEdit", "nbPost", "nbCancel", "nbRefresh"], "category": "Appearance" },
        { "name": "ConfirmDelete", "type": "Boolean", "default": true, "category": "Behavior" },
        { "name": "Hints", "type": "TStrings", "category": "Misc", "editor": "strings", "localizable": true },
        { "name": "TabOrder", "type": "Integer", "default": -1, "category": "Behavior", "min": -1, "max": 32767 },
