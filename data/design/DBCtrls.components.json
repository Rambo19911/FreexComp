  "eventSignatures": {
    "TNotifyEvent": "procedure(Sender: TObject)",
    "TKeyEvent": "procedure(Sender: TObject; var Key: Word; Shift: TShiftState)",
    "TKeyPressEvent": "procedure(Sender: TObject; var Key: Char)",
    "TNavClick": "procedure(Sender: TObject; Button: TNavigateBtn)"
  },
  "eventSignatureUnits": { "TNavigateBtn": "DBCtrls", "TShiftState": "Classes" }
}
