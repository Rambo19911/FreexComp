<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the setup program (installer.md §4). They write only scratch folders and HKCU\Software\FreexComp-SetupTest\<guid>. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FreexComp.Setup.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FreexComp.Setup\FreexComp.Setup.csproj" />
    <!-- The end-to-end tests debug a program with the installed debug adapter through the product's own client. -->
    <ProjectReference Include="..\..\..\debugger\src\FreexComp.Debugger\FreexComp.Debugger.csproj" />
    <!--
      The end-to-end install test runs the library source layout checks of the policy tests against the installed
      folder (LSRC-006), as a child process: the project is built first, its output is not referenced.
    -->
    <ProjectReference Include="..\..\..\tests\policy\FreexComp.Policy.Tests\FreexComp.Policy.Tests.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Child-process pipes read on dedicated threads (L-022). -->
    <Compile Include="..\..\..\tests\Shared\ChildPipe.cs" Link="Shared\ChildPipe.cs" />
  </ItemGroup>
</Project>
